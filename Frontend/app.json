{
  "expo": {
    "name": "Mafia",
    "slug": "mafia",
    "scheme": "mafia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mafiagame.app"
    },
    "android": {
      "package": "com.mafiagame.app",
      "adaptiveIcon": {
        "backgroundColor": "#070e1a",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c3f3a713-cf1a-4a62-9a69-09664a8e638f"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
